---
import { SITE, SOCIAL, CATEGORIES } from '../lib/site';
---

<footer class="mt-20 border-t border-ink-800 bg-ink-900">
  <div class="container-x py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-display text-lg font-bold">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-accent text-ink-900">U</span>
        <span class="text-white">Uzi <span class="text-ink-400">Network</span></span>
      </div>
      <p class="mt-3 max-w-sm text-sm text-ink-300">{SITE.description}</p>
      <div class="mt-5 flex gap-3">
        {SOCIAL.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer me"
             aria-label={s.label}
             class="rounded-md bg-ink-800 px-2.5 py-1.5 text-xs text-ink-200 hover:bg-ink-700 hover:text-white">{s.label}</a>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Browse</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {CATEGORIES.map(c => (
          <li><a href={`/reviews?category=${c.slug}`} class="text-ink-300 hover:text-white">{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Site</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about" class="text-ink-300 hover:text-white">About</a></li>
        <li><a href="/blog" class="text-ink-300 hover:text-white">Blog</a></li>
        <li><a href="/disclosure" class="text-ink-300 hover:text-white">Affiliate disclosure</a></li>
        <li><a href="/privacy" class="text-ink-300 hover:text-white">Privacy</a></li>
        <li><a href="/contact" class="text-ink-300 hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <div class="container-x py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-2xs text-ink-400">
      <p>© {new Date().getFullYear()} {SITE.name}. Reviews are paid for by us, not by brands.</p>
      <p>Built for speed. Made for the algorithm.</p>
    </div>
  </div>
</footer>