---
import { SITE, AFFILIATE_DISCLOSURE } from '../lib/site';
---

<section id="newsletter" class="border-y border-ink-800 bg-gradient-to-br from-ink-800/50 via-ink-900 to-ink-900">
  <div class="container-x py-14">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Weekly drops</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">
          The best tech and AI finds — sent every Friday.
        </h2>
        <p class="mt-3 max-w-md text-ink-300">
          One email. Five hand-picked things we tested this week. No spam, no recycled press releases.
        </p>
        <p class="mt-4 text-2xs text-ink-500 max-w-md">{AFFILIATE_DISCLOSURE.split('.')[0]}.</p>
      </div>

      <form
        id="newsletter-form"
        class="w-full max-w-md md:ml-auto"
        action="/api/subscribe"
        method="POST"
        novalidate
      >
        <label for="email" class="sr-only">Email address</label>
        <div class="flex flex-col gap-2 sm:flex-row">
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="you@domain.com"
            autocomplete="email"
            class="flex-1 rounded-lg bg-ink-800 px-4 py-3 text-sm text-white placeholder-ink-500 ring-1 ring-ink-700 focus:ring-accent"
          />
          <button type="submit" class="btn-primary px-5 py-3">Subscribe</button>
        </div>
        <p id="newsletter-msg" class="mt-3 min-h-[1.25rem] text-sm text-ink-300" aria-live="polite"></p>
        <p class="mt-2 text-2xs text-ink-500">By subscribing you agree to receive marketing emails. Unsubscribe any time.</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const msg = document.getElementById('newsletter-msg');
  if (form && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '...';
      try {
        const res = await fetch('/api/subscribe', { method: 'POST', body: data });
        const json = await res.json();
        msg.textContent = json.message ?? (res.ok ? 'Subscribed.' : 'Something went wrong.');
        msg.className = `mt-3 min-h-[1.25rem] text-sm ${res.ok ? 'text-green-400' : 'text-red-400'}`;
        if (res.ok) form.reset();
      } catch {
        msg.textContent = 'Network error. Try again.';
        msg.className = 'mt-3 min-h-[1.25rem] text-sm text-red-400';
      } finally {
        btn.disabled = false; btn.textContent = 'Subscribe';
      }
    });
  }
</script>