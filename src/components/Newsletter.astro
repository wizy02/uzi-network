---
interface Props {
  variant?: 'inline' | 'footer' | 'exit';
  title?: string;
  description?: string;
}

const {
  variant = 'inline',
  title = 'Get the 5 best tech deals this week',
  description = 'Free weekly email. The 5 best deals on tech we actually tested. No spam, unsubscribe anytime.',
} = Astro.props;

const formId = `newsletter-${variant}`;
---

{variant === 'inline' && (
  <div class="not-prose my-12 rounded-2xl border border-uzi-500/30 bg-gradient-to-br from-uzi-500/10 to-transparent p-8">
    <h3 class="text-2xl font-bold text-ink-50 mb-2">{title}</h3>
    <p class="text-ink-300 mb-6">{description}</p>
    <form
      id={formId}
      action="https://buttondown.email/api/emails/embed-subscribe/uzinetwork"
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.email/uzinetwork', 'popupwindow')"
      class="flex flex-col sm:flex-row gap-3"
    >
      <input
        type="email"
        name="email"
        id={`${formId}-email`}
        placeholder="you@example.com"
        required
        class="flex-1 px-4 py-3 rounded-lg bg-ink-900 border border-ink-700 text-ink-50 placeholder-ink-500 focus:outline-none focus:border-uzi-500"
      />
      <button
        type="submit"
        class="bg-uzi-500 hover:bg-uzi-600 text-white font-bold py-3 px-6 rounded-lg transition-colors whitespace-nowrap"
      >
        Subscribe free
      </button>
    </form>
    <p class="text-xs text-ink-500 mt-3">Join 0+ readers · One-click unsubscribe · No spam, ever</p>
  </div>
)}

{variant === 'footer' && (
  <form
    id={formId}
    action="https://buttondown.email/api/emails/embed-subscribe/uzinetwork"
    method="post"
    target="popupwindow"
    onsubmit="window.open('https://buttondown.email/uzinetwork', 'popupwindow')"
    class="flex flex-col sm:flex-row gap-2"
  >
    <input
      type="email"
      name="email"
      id={`${formId}-email`}
      placeholder="you@example.com"
      required
      class="flex-1 px-3 py-2 rounded-lg bg-ink-900 border border-ink-700 text-ink-50 placeholder-ink-500 text-sm focus:outline-none focus:border-uzi-500"
    />
    <button
      type="submit"
      class="bg-uzi-500 hover:bg-uzi-600 text-white font-bold py-2 px-4 rounded-lg transition-colors text-sm whitespace-nowrap"
    >
      Subscribe
    </button>
  </form>
)}

{variant === 'exit' && (
  <div id="exit-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
    <div class="bg-ink-800 rounded-2xl border border-uzi-500/30 p-8 max-w-md w-full relative">
      <button
        id="exit-close"
        type="button"
        class="absolute top-4 right-4 text-ink-400 hover:text-ink-50 text-2xl"
        aria-label="Close"
      >×</button>
      <h3 class="text-2xl font-bold text-ink-50 mb-2">Before you go —</h3>
      <p class="text-ink-300 mb-6">Get the 5 best tech deals this week. Free. No spam.</p>
      <form
        id={formId}
        action="https://buttondown.email/api/emails/embed-subscribe/uzinetwork"
        method="post"
        target="popupwindow"
        onsubmit="document.getElementById('exit-modal').classList.add('hidden'); window.open('https://buttondown.email/uzinetwork', 'popupwindow')"
        class="flex flex-col gap-3"
      >
        <input
          type="email"
          name="email"
          id={`${formId}-email`}
          placeholder="you@example.com"
          required
          class="px-4 py-3 rounded-lg bg-ink-900 border border-ink-700 text-ink-50 placeholder-ink-500 focus:outline-none focus:border-uzi-500"
        />
        <button
          type="submit"
          class="bg-uzi-500 hover:bg-uzi-600 text-white font-bold py-3 px-6 rounded-lg transition-colors"
        >
          Subscribe free
        </button>
      </form>
      <button
        id="exit-no-thanks"
        type="button"
        class="text-xs text-ink-500 hover:text-ink-300 mt-3 w-full text-center"
      >No thanks, I'll pay full price</button>
    </div>
  </div>

  <script is:inline>
    (function() {
      const modal = document.getElementById('exit-modal');
      const close = document.getElementById('exit-close');
      const noThanks = document.getElementById('exit-no-thanks');
      if (!modal) return;
      let shown = false;
      let dismissed = sessionStorage.getItem('exit-dismissed');
      document.addEventListener('mouseout', function(e) {
        if (shown || dismissed) return;
        if (e.clientY <= 0 && e.relatedTarget == null) {
          modal.classList.remove('hidden');
          shown = true;
        }
      });
      function hide() {
        modal.classList.add('hidden');
        sessionStorage.setItem('exit-dismissed', '1');
      }
      if (close) close.addEventListener('click', hide);
      if (noThanks) noThanks.addEventListener('click', hide);
    })();
  </script>
)}
