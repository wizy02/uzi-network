---
// Self-hosted pageview tracker. Sends a single pixel request to our own API.
// Privacy-friendly: no cookies, no personal data, no third-party scripts.
---

<script is:inline>
  (function() {
    if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;
    if (sessionStorage.getItem('uzi-tracked')) return;
    sessionStorage.setItem('uzi-tracked', '1');

    const data = {
      path: location.pathname,
      ref: document.referrer || '',
      ua: navigator.userAgent,
      vw: window.innerWidth,
      vh: window.innerHeight,
      ts: Date.now(),
    };

    // Send via sendBeacon (non-blocking, works on page unload)
    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/track-write', JSON.stringify(data));
    } else {
      fetch('/api/track-write', { method: 'POST', body: JSON.stringify(data), keepalive: true });
    }
  })();
</script>
