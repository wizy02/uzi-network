---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: '/forever',
    desc: 'The PDF + weekly newsletter + 247 review pages.',
    features: [
      'Free 8-page AI Tools PDF',
      'Weekly newsletter: The Drops',
      'Full AI tool directory (30 tools)',
      'Comparison pages (5 head-to-heads)',
      'Recommendations, no paywall',
    ],
    cta: 'Subscribe',
    ctaLink: '/ai-tools-guide',
    highlight: false,
  },
  {
    name: 'Pro',
    price: '$9',
    period: '/mo',
    desc: 'Exclusive discount codes + weekly deep-dives + community access.',
    features: [
      'Everything in Free',
      'Exclusive AI tool discount codes (save $100+/yr)',
      'Weekly deep-dive: one tool, tested for a month',
      'Priority reviews: you suggest, I test',
      'Community access (Discord)',
    ],
    cta: 'Join Pro',
    ctaLink: '/api/checkout',
    highlight: true,
  },
];
---

<BaseLayout
  title="Uzi Network Pro — Exclusive AI tool discounts"
  description="$9/month for exclusive AI tool discount codes, weekly deep-dives, and community access."
>
  <article class="container-x py-10">
    <header class="text-center">
      <h1 class="mt-1 text-4xl font-extrabold text-white sm:text-5xl">Uzi Network Pro</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-300">
        Get exclusive AI tool discount codes. Most save $100+ in their first month.
      </p>
    </header>

    <!-- Value props -->
    <section class="mt-10">
      <h2 class="text-center text-2xl font-bold text-white">What you get</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div class="card p-6 text-center">
          <p class="text-4xl">🎫</p>
          <h3 class="mt-3 font-bold text-white">Discount codes</h3>
          <p class="mt-2 text-sm text-ink-300">
            Every AI tool we recommend has a Pro discount. $5-20 off per tool, every month.
          </p>
        </div>
        <div class="card p-6 text-center">
          <p class="text-4xl">📊</p>
          <h3 class="font-bold text-white">Weekly deep-dives</h3>
          <p class="mt-2 text-sm text-ink-300">
            One tool, tested for 30 days. Full breakdown of value, cost, and alternatives.
          </p>
        </div>
        <div class="card p-6 text-center">
          <p class="text-4xl">🔥</p>
          <h3 class="font-bold text-white">You suggest, I test</h3>
          <p class="mt-2 text-sm text-ink-300">
            Pro subscribers get priority on tool recommendations. Vote in the Discord.
          </p>
        </div>
      </div>
    </section>

    <!-- Pricing comparison -->
    <section class="mt-12">
      <h2 class="text-center text-2xl font-bold text-white">Plans</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {tiers.map(t => (
          <div class={t.highlight ? 'card border-2 border-accent/40 p-6' : 'card p-6'}>
            <h3 class="text-xl font-bold text-white">{t.name}</h3>
            <p class="mt-2 text-4xl font-extrabold text-white">
              {t.price}<span class="text-lg text-ink-400">{t.period}</span>
            </p>
            <p class="mt-2 text-sm text-ink-300">{t.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-200">
              {t.features.map(f => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 text-green-400">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={t.ctaLink}
              class={t.highlight ? 'btn-primary mt-6 block text-center' : 'btn-ghost mt-6 block text-center'}
            >
              {t.cta}
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white">How discount codes work</h2>
      <p class="mt-2 text-sm text-ink-300">
        We negotiate discounts with AI tool companies for our subscribers. You get a unique code that saves you money on every tool we recommend.
      </p>
      <div class="mt-6 space-y-4">
        <div class="card flex items-start gap-4 p-4">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-accent/20 text-lg font-bold text-accent">
            1
          </div>
          <div>
            <h3 class="font-bold text-white">Subscribe</h3>
            <p class="mt-1 text-sm text-ink-300">Pay $9/month. No commitment, cancel anytime.</p>
          </div>
        </div>
        <div class="card flex items-start gap-4 p-4">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-accent/20 text-lg font-bold text-accent">
            2
          </div>
          <div>
            <h3 class="font-bold text-white">Get codes in your inbox</h3>
            <p class="mt-1 text-sm text-ink-300">Each week we email you exclusive codes for tools we've tested and recommended.</p>
          </div>
        </div>
        <div class="card flex items-start gap-4 p-4">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-accent/20 text-lg font-bold text-accent">
            3
          </div>
          <div>
            <h3 class="font-bold text-white">Save money on AI tools</h3>
            <p class="mt-1 text-sm text-ink-300">Apply the code when signing up. Most save $10-20 on their first tool alone.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white">FAQ</h2>
      <div class="mt-6 space-y-4">
        <div class="card p-5">
          <h3 class="font-bold text-white">What if I never use a discount code?</h3>
          <p class="mt-2 text-sm text-ink-300">
            You still get the weekly deep-dives and tool testing. But honestly, if you're using 2+ AI tools, you'll save more than $9/month on discounts alone.
          </p>
        </div>
        <div class="card p-5">
          <h3 class="font-bold text-white">Can I cancel anytime?</h3>
          <p class="mt-2 text-sm text-ink-300">Yes. No contracts. No questions. Cancel from your Lemon Squeezy portal.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-bold text-white">Are the codes unique to me?</h3>
          <p class="mt-2 text-sm text-ink-300">Codes are shared with all Pro subscribers. They're affiliate codes that give you a discount AND give us a commission. No conflict of interest — we test everything independently.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-bold text-white">What if my code doesn't work?</h3>
          <p class="mt-2 text-sm text-ink-300">Email us and we'll get you a new one within 24 hours. We verify all codes before sending them out.</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mt-12 rounded-2xl border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-8 text-center">
      <h2 class="text-2xl font-bold text-white">Start saving on AI tools today</h2>
      <p class="mx-auto mt-2 max-w-md text-ink-300">
        Most Pro subscribers save more than $9/month in their first week.
      </p>
      <a
        href="#join"
        class="btn-primary mt-5 inline-block px-8 py-4 text-lg font-bold"
      >
        Join Pro — $9/month
      </a>
      <p class="mt-3 text-sm text-ink-400">Sign up below to get notified when we open.</p>

      <!-- Sign up form -->
      <form
        id="join"
        method="POST"
        action="/api/subscribe"
        class="mt-6 max-w-md mx-auto flex gap-2"
      >
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          class="flex-1 rounded-lg border border-ink-700 bg-ink-900/50 px-4 py-3 text-sm text-white placeholder:text-ink-500 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          required
        />
        <button type="submit" class="btn-primary px-6 font-bold whitespace-nowrap">
          Join Pro
        </button>
      </form>
      <p class="mt-2 text-sm text-ink-400">We'll email you the checkout link when it's live.</p>
    </section>
  </article>
</BaseLayout>
