---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Uzi Network Pro — Exclusive AI tool discounts"
  description="$9/month for exclusive AI tool discounts, weekly deep-dives, and direct Q&A."
>
  <article class="container-x py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <!-- Hero -->
      <header class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Uzi Network Pro</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          The AI tools we use. At the price you want.
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-300">
          We negotiate exclusive discounts for our subscribers. $9/month gets you access to all of them.
        </p>
      </header>

      <!-- Pricing card -->
      <div class="mt-10 card overflow-hidden p-0">
        <div class="bg-gradient-to-br from-accent/20 to-accent/5 p-8 text-center">
          <p class="text-2xs uppercase tracking-wider text-accent">Monthly</p>
          <p class="mt-2 text-5xl font-extrabold text-white">$9<span class="text-base text-ink-300">/mo</span></p>
          <p class="mt-2 text-sm text-ink-300">Cancel anytime. No questions asked.</p>
        </div>
        <div class="p-8">
          <h2 class="font-bold text-white">What you get</h2>
          <ul class="mt-4 space-y-2 text-sm text-ink-200">
            <li class="flex gap-2"><span class="text-green-400">✓</span> <span><b>Exclusive discount codes</b> for 8+ AI tools (Claude, Make, ElevenLabs, etc.)</span></li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> <span><b>Weekly deep-dive</b> — one tool, full breakdown every Friday</span></li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> <span><b>First access</b> to new reviews and video drops</span></li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> <span><b>Direct Q&A</b> — ask us anything about the tools</span></li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> <span><b>No ads</b> on the site for Pro members</span></li>
          </ul>

          <!-- Checkout -->
          <button
            id="checkout-btn"
            class="btn-primary mt-8 w-full py-4 text-lg font-bold"
          >
            Subscribe to Pro — $9/mo
          </button>
          <p class="mt-3 text-center text-2xs text-ink-500">
            Powered by Lemon Squeezy. Works in South Africa and 200+ countries.
          </p>
        </div>
      </div>

      <!-- Money saved example -->
      <section class="mt-10">
        <h2 class="text-xl font-bold text-white">Real numbers</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="card p-4">
            <p class="text-2xs uppercase tracking-wider text-ink-400">Without Pro</p>
            <p class="mt-1 text-2xl font-extrabold text-white">$0 saved</p>
            <p class="mt-1 text-sm text-ink-300">Full price on every tool</p>
          </div>
          <div class="card p-4 border-accent/40">
            <p class="text-2xs uppercase tracking-wider text-accent">With Pro</p>
            <p class="mt-1 text-2xl font-extrabold text-accent">$30-80/mo saved</p>
            <p class="mt-1 text-sm text-ink-300">Average across 3-4 paid tools</p>
          </div>
        </div>
        <p class="mt-4 text-sm text-ink-300">
          If you pay for 1-2 of these tools, Pro pays for itself in week 1.
        </p>
      </section>

      <!-- FAQ -->
      <section class="mt-10">
        <h2 class="text-xl font-bold text-white">FAQ</h2>
        <div class="mt-4 space-y-3">
          <details class="card p-4">
            <summary class="cursor-pointer font-semibold text-white">Where do the discounts come from?</summary>
            <p class="mt-2 text-sm text-ink-300">We negotiate directly with each tool's affiliate team. Some are 20% off, some are 50% off first month, some are extended trials.</p>
          </details>
          <details class="card p-4">
            <summary class="cursor-pointer font-semibold text-white">Can I cancel?</summary>
            <p class="mt-2 text-sm text-ink-300">Yes, anytime. No contracts. Lemon Squeezy handles the billing.</p>
          </details>
          <details class="card p-4">
            <summary class="cursor-pointer font-semibold text-white">What if I don't use any of the tools?</summary>
            <p class="mt-2 text-sm text-ink-300">Then Pro isn't for you. The free newsletter is still great. We won't spam you trying to upsell.</p>
          </details>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  document.getElementById('checkout-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('checkout-btn');
    btn.disabled = true;
    btn.textContent = 'Loading checkout...';
    try {
      const res = await fetch('/api/checkout', { method: 'POST' });
      const j = await res.json();
      if (j.url) {
        window.location.href = j.url;
      } else {
        btn.textContent = 'Checkout failed — try again';
      }
    } catch (err) {
      btn.textContent = 'Network error — try again';
    } finally {
      setTimeout(() => { btn.disabled = false; btn.textContent = 'Subscribe to Pro — $9/mo'; }, 2000);
    }
  });
</script>
