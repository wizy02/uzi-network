---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Uzi Network.">
  <section class="container-x py-12 max-w-2xl">
    <h1 class="text-4xl font-bold text-white">Contact</h1>
    <p class="mt-3 text-ink-300">
      The fastest way to reach us is email. We're a small team, but we read everything.
    </p>

    <div class="mt-8 space-y-6">
      <div class="card p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">Editorial / Pitches</h2>
        <p class="mt-2 text-ink-200">Want to write for us, pitch a review, or send a press kit?</p>
        <a href="mailto:hello@uzi.network.store" class="mt-3 inline-block text-lg font-bold text-white hover:text-accent">hello@uzi.network.store</a>
      </div>
      <div class="card p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">Partnerships / Affiliate</h2>
        <p class="mt-2 text-ink-200">Brand partnerships, sponsored content, and affiliate program inquiries.</p>
        <a href="mailto:partners@uzi.network.store" class="mt-3 inline-block text-lg font-bold text-white hover:text-accent">partners@uzi.network.store</a>
      </div>
      <div class="card p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">Privacy / Data Requests</h2>
        <p class="mt-2 text-ink-200">Unsubscribe, data deletion, or privacy questions.</p>
        <a href="mailto:privacy@uzi.network.store" class="mt-3 inline-block text-lg font-bold text-white hover:text-accent">privacy@uzi.network.store</a>
      </div>
    </div>
  </section>
</BaseLayout>