---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Revenue Dashboard"
  description="Internal: Uzi Network revenue and conversion tracking."
  noIndex
>
  <article class="container-x py-10">
    <header>
      <p class="text-2xs uppercase tracking-wider text-accent">Internal</p>
      <h1 class="mt-1 text-3xl font-extrabold text-white">Revenue Dashboard</h1>
      <p class="mt-2 text-sm text-ink-300">Last 30 days · Real-time</p>
    </header>

    <!-- KPI cards -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-5">
        <p class="text-2xs uppercase tracking-wider text-ink-400">Newsletter Subs</p>
        <p class="mt-2 text-3xl font-extrabold text-white" id="kpi-newsletter">--</p>
        <p class="mt-1 text-2xs text-ink-500" id="kpi-newsletter-delta">last 7 days</p>
      </div>
      <div class="card p-5">
        <p class="text-2xs uppercase tracking-wider text-ink-400">Pro Subscribers</p>
        <p class="mt-2 text-3xl font-extrabold text-accent" id="kpi-pro">--</p>
        <p class="mt-1 text-2xs text-ink-500">$9/mo each</p>
      </div>
      <div class="card p-5">
        <p class="text-2xs uppercase tracking-wider text-ink-400">API Keys Issued</p>
        <p class="mt-2 text-3xl font-extrabold text-white" id="kpi-api">--</p>
        <p class="mt-1 text-2xs text-ink-500">free tier</p>
      </div>
      <div class="card p-5">
        <p class="text-2xs uppercase tracking-wider text-ink-400">Affiliate Clicks</p>
        <p class="mt-2 text-3xl font-extrabold text-white" id="kpi-clicks">--</p>
        <p class="mt-1 text-2xs text-ink-500" id="kpi-clicks-delta">last 7 days</p>
      </div>
    </div>

    <!-- Revenue card -->
    <div class="mt-6 card border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-6">
      <p class="text-2xs uppercase tracking-wider text-accent">Estimated MRR</p>
      <p class="mt-2 text-5xl font-extrabold text-accent" id="kpi-mrr">$0</p>
      <p class="mt-1 text-2xs text-ink-500">Pro subscribers × $9 + affiliate estimate</p>
    </div>

    <!-- Top affiliate links -->
    <section class="mt-8">
      <h2 class="text-xl font-bold text-white">Top performing affiliate links</h2>
      <div class="mt-4 card overflow-hidden p-0">
        <table class="w-full text-sm">
          <thead class="bg-ink-800 text-2xs uppercase tracking-wider text-ink-400">
            <tr>
              <th class="p-3 text-left">Network</th>
              <th class="p-3 text-right">Clicks</th>
              <th class="p-3 text-right">Est. Revenue</th>
            </tr>
          </thead>
          <tbody id="affiliate-table">
            <tr><td colspan="3" class="p-3 text-ink-400">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Last events -->
    <section class="mt-8">
      <h2 class="text-xl font-bold text-white">Recent events</h2>
      <div class="mt-4 card p-0">
        <pre id="events-log" class="overflow-x-auto p-4 text-2xs text-ink-300" style="max-height: 300px;">Loading…</pre>
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  // Note: this is a placeholder. In production, query the tracking KV via /api/stats
  // For now, just show the structure so we know what to fill in.

  document.getElementById('kpi-newsletter').textContent = '0';
  document.getElementById('kpi-pro').textContent = '0';
  document.getElementById('kpi-api').textContent = '0';
  document.getElementById('kpi-clicks').textContent = '0';
  document.getElementById('kpi-mrr').textContent = '$0';
  document.getElementById('affiliate-table').innerHTML = '<tr><td colspan="3" class="p-3 text-ink-400">No data yet — events will appear here as users click affiliate links.</td></tr>';
  document.getElementById('events-log').textContent = 'No events yet. Add ?key=YOUR_ADMIN_KEY to see real-time data.';
</script>
