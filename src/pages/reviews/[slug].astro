---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/Rating.astro';
import Newsletter from '../../components/Newsletter.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { AFFILIATE_DISCLOSURE, CATEGORIES } from '../../lib/site';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => ({
    params: { slug: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);
const { data } = review;

const cat = CATEGORIES.find(c => c.slug === data.category);
---

<BaseLayout
  title={data.title}
  description={data.tldr ?? data.verdict}
  type="article"
  ogImage={data.cover}
>
  <!-- Review Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: data.title,
    reviewBody: data.verdict,
    author: { '@type': 'Organization', name: 'Uzi Network' },
    datePublished: data.releaseDate.toISOString(),
    itemReviewed: {
      '@type': 'Product',
      name: data.title,
      brand: data.brand,
      category: cat?.label,
      image: data.cover,
      offers: {
        '@type': 'Offer',
        price: data.priceUsd,
        priceCurrency: 'USD',
        url: data.affiliate.url,
      },
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: data.rating,
      bestRating: 5,
    },
  })} />

  <article class="container-x py-10">
    <nav class="text-2xs uppercase tracking-wider text-ink-400">
      <a href="/reviews" class="hover:text-white">Reviews</a>
      <span class="mx-2">/</span>
      <a href={`/reviews?category=${data.category}`} class="hover:text-white">{cat?.label}</a>
    </nav>

    <header class="mt-3 grid gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <div class="mb-3">
          <BrandLogo brand={data.brand} size="lg" />
        </div>
        <h1 class="mt-1 text-3xl font-extrabold text-white sm:text-4xl">{data.title}</h1>
        <p class="mt-3 max-w-2xl text-lg text-ink-300">{data.tldr ?? data.verdict}</p>
        <div class="mt-5 flex flex-wrap items-center gap-4 text-sm text-ink-300">
          <Rating rating={data.rating} size="md" showValue />
          <span>•</span>
          <span>{data.releaseDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          {data.lastUpdated && (
            <>
              <span>•</span>
              <span>Updated {data.lastUpdated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </>
          )}
        </div>
      </div>

      <!-- Sticky buy box — big product image, clear price, clickable CTA -->
      <aside class="lg:w-96">
        <div class="card overflow-hidden p-0 lg:sticky lg:top-20">
          {data.cover && (
            <div class="relative aspect-square w-full overflow-hidden bg-ink-800">
              <img
                src={data.cover}
                alt={`${data.brand} ${data.title} product photo`}
                class="h-full w-full object-cover"
                loading="eager"
              />
              <div class="absolute top-3 left-3">
                <BrandLogo brand={data.brand} size="sm" />
              </div>
            </div>
          )}
          <div class="p-5">
            <div class="flex items-center justify-between">
              <span class="text-2xs uppercase tracking-wider text-ink-400">Current price</span>
              <Rating rating={data.rating} size="sm" />
            </div>
            <p class="mt-1 text-3xl font-extrabold text-white">{data.price}</p>

            <a
              href={data.affiliate.url}
              data-affiliate={data.affiliate.network}
              data-affiliate-tag={data.affiliate.tag}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="btn-primary mt-4 flex w-full items-center justify-center gap-2 py-4 text-base font-bold"
              onclick="if(window.plausible) plausible('affiliate_click', {props: {slug: window.location.pathname, network: this.dataset.affiliate}})"
            >
              <span>Check price on {data.brand}</span>
              <span class="text-lg">→</span>
            </a>
            <p class="mt-3 text-2xs leading-relaxed text-ink-500">{AFFILIATE_DISCLOSURE}</p>
          </div>
        </div>
      </aside>
    </header>

    <!-- Pros / Cons quick grid -->
    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-green-400">What we like</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-200">
          {data.pros.map(p => (
            <li class="flex gap-2"><span class="text-green-400">+</span><span>{p}</span></li>
          ))}
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-red-400">What we don't</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-200">
          {data.cons.map(c => (
            <li class="flex gap-2"><span class="text-red-400">−</span><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Body content (MDX) -->
    <section class="prose-blog mt-12">
      <Content />
    </section>

    <!-- Tags -->
    {data.tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-ink-800 pt-8">
        {data.tags.map(t => <span class="chip">{t}</span>)}
      </div>
    )}

    <!-- Bottom CTA — bigger, more clickable -->
    <div class="mt-12 rounded-2xl border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Our verdict</p>
      <p class="mx-auto mt-2 max-w-2xl text-xl font-bold text-white">{data.verdict}</p>
      <div class="mt-5 flex flex-col items-center gap-2">
        <a
          href={data.affiliate.url}
          target="_blank" rel="sponsored noopener noreferrer"
          class="btn-primary inline-flex items-center gap-2 px-8 py-4 text-lg font-bold"
          data-affiliate={data.affiliate.network}
        >
          <span>See current price on {data.brand}</span>
          <span>→</span>
        </a>
        <p class="text-2xs text-ink-500">{AFFILIATE_DISCLOSURE}</p>
      </div>
    </div>
  </article>

  <Newsletter />
</BaseLayout>