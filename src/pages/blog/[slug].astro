---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  ogImage={post.data.cover}
>
  <article class="container-x py-10 max-w-3xl">
    <nav class="text-2xs uppercase tracking-wider text-ink-400">
      <a href="/blog" class="hover:text-white">Blog</a>
    </nav>

    <header class="mt-3">
      <div class="flex items-center gap-3 text-2xs uppercase tracking-wider text-ink-400">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <span>•</span>
        <span>{post.data.author}</span>
      </div>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white">{post.data.title}</h1>
      <p class="mt-3 text-lg text-ink-300">{post.data.description}</p>
    </header>

    {post.data.cover && (
      <img src={post.data.cover} alt="" class="mt-8 w-full rounded-xl ring-1 ring-ink-700 aspect-video object-cover" />
    )}

    <div class="prose-blog mt-10">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-ink-800 pt-8">
        {post.data.tags.map(t => <span class="chip">{t}</span>)}
      </div>
    )}
  </article>
</BaseLayout>