---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout title="Blog" description="Deep dives, monetization research, and the occasional rant.">
  <section class="container-x py-10">
    <h1 class="text-4xl font-bold text-white">Blog</h1>
    <p class="mt-2 max-w-2xl text-ink-300">Monetization research, platform reviews, and how we're building Uzi Network in public.</p>

    <div class="mt-8 grid gap-6">
      {posts.map(post => (
        <article class="card p-6 hover:ring-ink-500">
          <a href={`/blog/${post.id}`} class="block">
            <div class="flex items-center gap-3 text-2xs uppercase tracking-wider text-ink-400">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
              {post.data.tags[0] && <span class="chip">{post.data.tags[0]}</span>}
            </div>
            <h2 class="mt-2 text-2xl font-bold text-white hover:text-accent transition">{post.data.title}</h2>
            <p class="mt-2 max-w-3xl text-ink-300">{post.data.description}</p>
            <p class="mt-3 text-sm text-brand-300">Read more →</p>
          </a>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="mt-12 text-center text-ink-400">No posts yet. Subscribe — we publish weekly.</p>
    )}
  </section>
</BaseLayout>