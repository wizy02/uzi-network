---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BEST_OF, PRODUCTS } from '../lib/catalog';
---

<BaseLayout
  title="Best Tech, AI & Productivity Picks — Curated Lists for 2026"
  description="Every best-of list we maintain. Updated quarterly based on real testing. No paid placement."
>

  <article class="container-x py-12 max-w-4xl">
    <header class="mb-12">
      <h1 class="text-5xl font-black text-ink-50 mb-4">Best of 2026</h1>
      <p class="text-xl text-ink-300">Every category we cover. Updated quarterly. No paid placement, no spec-sheet theater.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-6 not-prose">
      {BEST_OF.map(topic => (
        <a
          href={`/best/${topic.slug}/`}
          class="block bg-ink-800/50 rounded-2xl p-6 border border-ink-700 hover:border-uzi-500 transition-colors"
        >
          <div class="text-xs uppercase tracking-wider text-uzi-500 mb-2">{topic.category}</div>
          <h2 class="text-2xl font-bold text-ink-50 mb-2">{topic.title}</h2>
          <p class="text-ink-300 text-sm mb-4">{topic.intro}</p>
          <div class="text-uzi-500 font-semibold">Read the list →</div>
        </a>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-3xl font-black text-ink-50 mb-6">All products we cover</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 not-prose">
        {PRODUCTS.map(p => (
          <a
            href={`/reviews/${p.slug}/`}
            class="block bg-ink-800/30 rounded-xl p-4 border border-ink-700 hover:border-uzi-500 transition-colors"
          >
            <div class="text-ink-200 font-semibold">{p.name}</div>
            <div class="text-sm text-uzi-500 mt-1">{p.bestFor}</div>
            <div class="text-sm text-ink-400 mt-2">{p.price === 0 ? 'Free' : '$' + p.price} · {p.rating}/5</div>
          </a>
        ))}
      </div>
    </section>

  </article>
</BaseLayout>
