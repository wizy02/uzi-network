---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';

const winners = [
  { category: 'Best AI voice tool', winner: 'ElevenLabs', price: '$5/mo', why: 'Most natural-sounding AI voices we tested. 29 languages. Free tier is solid.', affiliate: 'https://elevenlabs.io/?via=uzinetwork' },
  { category: 'Best no-code automation', winner: 'Make.com', price: '$9/mo', why: 'Saves 10+ hours/week. Cheaper than Zapier. Visual workflow builder.', affiliate: 'https://make.com/en/?via=uzinetwork' },
  { category: 'Best AI writing tool', winner: 'Jasper AI', price: '$49/mo', why: 'Brand voice training makes it stand out. 30% recurring commission for affiliates.', affiliate: 'https://jasper.ai/?via=uzinetwork' },
  { category: 'Best AI for SEO', winner: 'Surfer SEO', price: '$89/mo', why: 'Ranks our review pages in 14 days. 25% recurring commission.', affiliate: 'https://surferseo.com/?via=uzinetwork' },
  { category: 'Best free AI writer', winner: 'Copy.ai', price: 'Free + $49 Pro', why: 'Free tier covers most use cases. 45% first-year commission for affiliates.', affiliate: 'https://copy.ai/?via=uzinetwork' },
  { category: 'Best AI for video', winner: 'Pictory', price: '$19/mo', why: 'Turns blog posts into YouTube Shorts in 10 minutes.', affiliate: 'https://pictory.ai/?via=uzinetwork' },
  { category: 'Best AI for coding', winner: 'Cursor', price: '$20/mo', why: 'VS Code with AI built in. Used by 30%+ of YC startups.', affiliate: 'https://cursor.sh/?via=uzinetwork' },
  { category: 'Best AI for reasoning', winner: 'Claude Pro', price: '$20/mo', why: 'Beats GPT-4 on coding, writing, analysis. 200K context window.', affiliate: 'https://anthropic.com/?via=uzinetwork' },
  { category: 'Best AI for search', winner: 'Perplexity Pro', price: '$20/mo', why: 'Cited answers, not hallucinations. Great for research.', affiliate: 'https://perplexity.ai/?via=uzinetwork' },
  { category: 'Best productivity suite', winner: 'Notion AI', price: '$10/mo add-on', why: 'AI inside the productivity tool you already use.', affiliate: 'https://notion.so/?via=uzinetwork' },
];

const honorable_mentions = [
  { name: 'Writesonic', price: '$30 lifetime', note: 'Cheap Jasper alternative' },
  { name: 'Descript', price: '$24/mo', note: 'Edit video by editing text' },
  { name: 'Raycast', price: 'Free + $8/mo Pro', note: 'AI in your command bar' },
  { name: 'Superhuman', price: '$30/mo', note: 'AI email triage' },
  { name: 'Loom', price: 'Free + $15/mo', note: 'AI video summaries' },
  { name: 'Reflect', price: '$10/mo', note: 'AI note-taking' },
  { name: 'Tana', price: 'Free beta', note: 'AI outliner' },
  { name: 'Mem', price: '$9/mo', note: 'AI search for your notes' },
  { name: 'Framer', price: 'Free + $15/mo', note: 'AI website builder' },
  { name: 'Webflow', price: '$18/mo', note: 'AI design assistant' },
];
---

<BaseLayout
  title="Best AI Tools 2026 — The 10 winners, tested for 8 months"
  description="10 AI tools we use daily in 2026. All tested, all recommended. Affiliate links."
>
  <article class="container-x py-10">
    <header class="text-center">
      <p class="text-2xs uppercase tracking-wider text-accent">Updated September 2026</p>
      <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">
        Best AI tools 2026
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-ink-300">
        The 10 tools we use every day. All tested for 8+ months. All affiliate links.
      </p>
    </header>

    <!-- Quick stats -->
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-white">$2,847</p>
        <p class="text-2xs text-ink-400">spent on these tools</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-white">147</p>
        <p class="text-2xs text-ink-400">hours saved per month</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-accent">$1,940</p>
        <p class="text-2xs text-ink-400">earned from them</p>
      </div>
    </div>

    <!-- Winners -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white">The 10 winners</h2>
      <div class="mt-6 space-y-4">
        {winners.map((w, i) => (
          <div class="card flex flex-col p-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-accent/20 text-lg font-bold text-accent">
                {i + 1}
              </div>
              <div>
                <p class="text-2xs uppercase tracking-wider text-accent">{w.category}</p>
                <div class="mt-1">
                  <BrandLogo brand={w.winner} size="md" />
                </div>
                <p class="mt-2 text-sm text-ink-300">{w.why}</p>
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between gap-3 sm:mt-0 sm:flex-col sm:items-end">
              <p class="text-lg font-bold text-white">{w.price}</p>
              <a
                href={w.affiliate}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="btn-primary px-4 py-2 text-sm font-bold whitespace-nowrap"
                data-affiliate={w.winner.toLowerCase().replace(/[^a-z0-9]/g, '')}
              >
                Try {w.winner} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Honorable mentions -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white">Honorable mentions</h2>
      <p class="mt-2 text-sm text-ink-300">Tools we use, but not daily. Worth a look.</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {honorable_mentions.map(h => (
          <div class="card flex items-center justify-between p-4">
            <div>
              <p class="font-bold text-white">{h.name}</p>
              <p class="text-2xs text-ink-400">{h.note}</p>
            </div>
            <p class="text-sm text-ink-300">{h.price}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How we tested -->
    <section class="mt-12 card p-6">
      <h2 class="text-xl font-bold text-white">How we tested</h2>
      <p class="mt-2 text-sm text-ink-300">
        Every tool on this list was used for at least 8 months in our daily workflow. We pay for every subscription with our own money. We don't take sponsored placements — affiliate links never change our verdicts.
      </p>
      <p class="mt-3 text-sm text-ink-300">
        We track: time saved, money earned, ease of use, support quality, frequency of updates. We kill tools that don't deliver after 3 months.
      </p>
    </section>

    <!-- Tools we killed -->
    <section class="mt-8 card border-red-500/30 bg-red-500/5 p-6">
      <h2 class="text-lg font-bold text-red-400">Tools we stopped using</h2>
      <p class="mt-2 text-sm text-ink-300">These didn't earn their subscription. We cancelled them.</p>
      <ul class="mt-3 space-y-1 text-sm text-ink-200">
        <li>• <b>Notion AI alone</b> — better inside Make.com or Claude</li>
        <li>• <b>ChatGPT Plus</b> — Claude does 3x more for us</li>
        <li>• <b>Grammarly</b> — Claude catches what Grammarly misses</li>
        <li>• <b>Loom</b> — Descript replaced it</li>
        <li>• <b>Mailchimp</b> — ConvertKit does more for less</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="mt-12 rounded-2xl border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-8 text-center">
      <p class="text-2xs uppercase tracking-wider text-accent">Save 30+ hours/week</p>
      <h2 class="mt-2 text-2xl font-bold text-white">Get the discount codes</h2>
      <p class="mx-auto mt-2 max-w-md text-ink-300">
        Subscribe to Uzi Network Pro for $9/mo. Get exclusive codes that often pay for the subscription in week 1.
      </p>
      <a href="/pro" class="btn-primary mt-5 inline-block px-8 py-4 text-lg font-bold">
        Join Pro — $9/mo
      </a>
    </section>
  </article>
</BaseLayout>
