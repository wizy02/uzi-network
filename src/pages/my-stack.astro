      { name: 'Figma', price: 'Free + $15/mo', why: 'Industry standard design tool with AI features.' },
      { name: 'Webflow', price: '$18/mo', why: 'AI website builder. No code needed.' },
      { name: 'Framer', price: 'Free + $15/mo', why: 'AI-powered website builder. Interactive prototypes.' },
    ],
  },
  {
    category: 'Productivity & Focus',
    tools: [
      { name: 'Notion', price: 'Free + $10/mo add-on', why: 'All-in-one workspace. AI Q&A powerful.' },
      { name: 'Raycast', price: 'Free + $8/mo', why: 'AI in your command bar. Supercharges macOS.' },
      { name: 'Mem', price: '$9/mo', why: 'AI search for your notes. Find anything instantly.' },
      { name: 'Reflect', price: '$10/mo', why: 'AI note-taking. Links ideas automatically.' },
      { name: 'Linear', price: 'Free + $8/mo', why: 'Fastest issue tracker. Built for engineers.' },
    ],
  },
  {
    category: 'Communication',
    tools: [
      { name: 'Superhuman', price: '$30/mo', why: 'AI email triage. Inbox zero in minutes.' },
      { name: 'Loom', price: 'Free + $15/mo', why: 'AI video summaries. Replace long emails.' },
      { name: 'Arc', price: 'Free', why: 'AI browser. Organizes tabs and spaces.' },
    ],
  },
  {
    category: 'Development',
    tools: [
      { name: 'Cursor', price: '$20/mo', why: 'VS Code with AI built in. Pair programming.' },
      { name: 'Replit', price: 'Free + $7/mo', why: 'AI-powered IDE. Great for learning.' },
