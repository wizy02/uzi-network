      { name: 'Descript', price: '$24/mo', why: 'Edit video by editing text. Revolutionary.' },
      { name: 'ElevenLabs', price: '$5/mo', why: 'Most natural-sounding AI voices. 29 languages.' },
      { name: 'Pictory', price: '$19/mo', why: 'Turn blog posts into videos in 10 minutes.' },
    ],
  },
  {
    category: 'SEO & Research',
    tools: [
      { name: 'Surfer SEO', price: '$89/mo', why: 'AI content optimization. Ranks pages in 14 days.' },
      { name: 'Perplexity Pro', price: '$20/mo', why: 'Cited AI search. Great for research.' },
      { name: 'Notion AI', price: '$10/mo', why: 'AI inside your second brain. Query your notes.' },
    ],
