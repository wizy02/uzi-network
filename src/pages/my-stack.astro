    moneySaved: '$10/month',
    icon: '🚫'
  },
  { 
    name: 'ChatGPT Plus', 
    reason: 'Claude does 3x more for us (coding, writing, analysis)', 
    alternative: 'Claude Pro for all text-based tasks',
    timeSaved: '5 hours/week', 
    moneySaved: '$20/month',
    icon: '🚫'
  },
  { 
    name: 'Grammarly', 
    reason: 'Claude catches what Grammarly misses in context', 
    alternative: 'Claude Pro for writing assistance',
    timeSaved: '2 hours/week',
    moneySaved: '$30/month',
    icon: '🚫'
  },
  { 
    name: 'Loom', 
    reason: 'Descript replaced it for video editing', 
    alternative: 'Descript for video editing by text',
    timeSaved: '1 hour/week',
    moneySaved: '$15/month',
    icon: '🚫'
  },
  {  { 
    name: 'Mailchimp', 
    reason: 'ConvertKit does more for less (email automation)', 
    alternative: 'ConvertKit for email newsletters',
    timeSaved: '4 hours/week',
    moneySaved: '$20/month',
    icon: '🚫'
  },
  { 
    name: 'Jasper Art', 
    reason: 'Midjourney and DALL-E 3 are better for image generation', 
    alternative: 'Use Claude for prompts + Midjourney/DALL-E',
    timeSaved: '1 hour/week',
    moneySaved: '$20/month',
    icon: '🚫'
  },
  { 
    name: 'Surfer AI (content generation)', 
    reason: 'Sounds robotic, needs heavy editing', 
    alternative: 'Use Surfer for optimization, Claude for writing',
    timeSaved: '3 hours/week',
    moneySaved: '$29/month',
    icon: '🚫'
  }
];

const stack = [
  {
    category: 'AI Writing & Reasoning',
    tools: [
      { name: 'Claude Pro', price: '$20/mo', why: 'Best for coding, writing, analysis. 200K context.' },
      { name: 'Jasper AI', price: '$49/mo', why: 'Brand voice training for consistent output.' },
      { name: 'Copy.ai', price: 'Free + $49 Pro', why: 'Free tier, 90+ templates for quick copy.' },
    ],
  },
  {
    category: 'Automation & Workflow',
    tools: [
      { name: 'Make.com', price: '$9/mo', why: 'Visual automation builder. Saves 10+ hours/week.' },
      { name: 'Zapier', price: '$20/mo', why: 'Easier to learn, but 2x the cost of Make.com.' },
      { name: 'Warp', price: 'Free', why: 'AI terminal. Natural language commands.' },
    ],
  },
  {
    category: 'Video & Audio',
