    ],
  }
];

const testimonials = [
  { 
    name: 'Alex R.', 
    role: 'Freelance Developer', 
    text: 'Switching from ChatGPT to Claude Pro saved me 5 hours a week on coding tasks. The 200K context window is a game-changer for understanding large codebases.' 
  },
  { 
    name: 'Sam T.', 
    role: 'Content Creator', 
    text: 'The Jasper AI brand voice feature alone saves me 3 hours per client. No more rewriting to match their tone.' 
  },
  { 
    name: 'Taylor K.', 
    role: 'SEO Specialist', 
    text: 'Surfer SEO paid for itself in the first week. My pages started ranking in 2 weeks instead of 2 months.' 
  }
];
---

<BaseLayout
  title="What I Use & Avoid — My AI Stack in 2026"
  description="Honest breakdown of the AI tools I use daily, the ones I avoid, and why. Updated September 2026."
>
  <article class="container-x py-10">
    <header class="text-center">
      <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">
        My AI Stack in 2026
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-ink-300">
        Tools I use daily vs. tools I avoid. All tested for 8+ months. No sponsored content.
      </p>
    </header>

    <!-- Quick stats -->
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-white">$2,847</p>
        <p class="text-2xs text-ink-400">spent on AI tools this year</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-white">147</p>
        <p class="text-2xs text-ink-400">hours saved per month</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-3xl font-extrabold text-accent">$1,940</p>
        <p class="text-2xs text-ink-400">earned from them</p>
      </div>
    </div>

    <!-- What I Avoid -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white text-center">Tools I Avoid</h2>
      <p class="mt-2 text-sm text-ink-300 text-center">
        These didn't earn their keep. I cancelled them after testing.
      </p>
      <div class="mt-6 space-y-4">
        {avoided.map((a, i) => (
          <div class="card flex flex-col p-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-red-500/20 text-lg font-bold text-red-400">
                {a.icon}
              </div>
              <div>
                <p class="text-2xs uppercase tracking-wider text-red-400">{a.name}</p>
                <div class="mt-1">
                  <p class="text-sm text-ink-300">{a.reason}</p>
                  {a.alternative && <p class="mt-1 text-2xs text-ink-400">Better alternative: {a.alternative}</p>}
                </div>
                {a.timeSaved && <p class="mt-1 text-sm text-ink-300">⏱️ Saves {a.timeSaved}</p>}
                {a.moneySaved && <p class="mt-1 text-sm text-ink-300">💰 Saves {a.moneySaved}</p>}
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between gap-3 sm:mt-0 sm:flex-col sm:items-end">
              <p class="text-lg font-bold text-red-400">AVOID</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- What I Use -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white text-center">My Daily Stack</h2>
      <p class="mt-2 text-sm text-ink-300 text-center">
        Tools I pay for and use every single day. Organized by category.
      </p>
      <div class="mt-6 space-y-6">
        {stack.map((category, catIndex) => (
          <div class="key" key={catIndex}>
            <h3 class="text-xl font-bold text-white mb-4">{category.category}</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {category.tools.map((tool, toolIndex) => (
                <div key={toolIndex} class="card p-4">
                  <div class="flex items-start justify-between">
                    <BrandLogo brand={tool.name} size="sm" />
                    <p class="text-sm font-bold text-accent">{tool.price}</p>
                  </div>
                  <p class="mt-2 text-2xs uppercase tracking-wider text-ink-400">{category.category}</p>
                  <p class="mt-1 text-sm text-ink-300">{tool.why}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Testimonials -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-white">What Others Say</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {testimonials.map((t, index) => (
          <div key={index} class="card p-6">
            <p class="mb-2 text-italic text-ink-300">"{t.text}"</p>
            <p class="mt-2 text-sm font-bold text-white">— {t.name}, {t.role}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How I Test -->
    <section class="mt-12 card p-6">
      <h2 class="text-xl font-bold text-white">My Testing Process</h2>
      <p class="mt-2 text-sm text-ink-300">
        Every tool on this list was used for at least 3 months in my daily workflow. I pay for every subscription with my own money. I don't take sponsored placements — affiliate links never change my verdicts.
      </p>
      <p class="mt-3 text-sm text-ink-300">
        I track: time saved, money earned, ease of use, support quality, frequency of updates. I kill tools that don't deliver after 3 months.
      </p>
    </section>

    <!-- CTA -->
    <section class="mt-12 rounded-2xl border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-8 text-center">
      <p class="text-2xs uppercase tracking-wider text-accent">Build your own stack</p>
      <h2 class="mt-2 text-2xl font-bold text-white">Start with the free trials</h2>
      <p class="mx-auto mt-2 max-w-md text-ink-300">
        Most of these tools have free tiers or trials. Start there, then upgrade what earns its keep.
      </p>
      <a href="/ai-tools/directory" class="btn-primary mt-5 inline-block px-8 py-4 text-lg font-bold">
        See the full directory
      </a>
    </section>
  </article>
</BaseLayout>