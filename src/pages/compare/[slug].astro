---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';

export async function getStaticPaths() {
  const comparisons = [
    { slug: 'jasper-vs-copy-ai', a: 'Jasper', b: 'Copy.ai', winner: 'Jasper', 
      intro: 'Both are solid AI writing tools. After 8 months of daily use, here\'s how they stack up.',
      points: [
        { feature: 'Brand voice training', a: 'Excellent', b: 'Basic' },
        { feature: 'Templates', a: '90+', b: '90+' },
        { feature: 'Price (Pro)', a: '$49/mo', b: '$49/mo' },
        { feature: 'Free tier', a: '7-day trial', b: 'Yes (limited)' },
        { feature: 'Long-form docs', a: 'Excellent', b: 'Good' },
        { feature: 'Multi-language', a: '30+', b: '20+' },
      ],
      verdict: 'Jasper wins if you have a brand voice to maintain. Copy.ai wins if you\'re a solo creator on a budget.' },
    { slug: 'elevenlabs-vs-descript', a: 'ElevenLabs', b: 'Descript', winner: 'ElevenLabs',
      intro: 'Different tools for different jobs. We use both.',
      points: [
        { feature: 'Voice generation', a: 'Best in class', b: 'Good' },
        { feature: 'Video editing', a: 'No', b: 'Best in class' },
        { feature: 'Price', a: '$5/mo', b: '$24/mo' },
        { feature: 'Free tier', a: 'Yes (10K chars)', b: 'No' },
        { feature: 'Voice cloning', a: 'Yes', b: 'Limited' },
        { feature: 'Auto-captions', a: 'No', b: 'Yes' },
      ],
      verdict: 'ElevenLabs for voiceover. Descript for editing. Use both.' },
    { slug: 'make-vs-zapier', a: 'Make.com', b: 'Zapier', winner: 'Make.com',
      intro: 'Make.com is the no-code tool we use daily. Zapier is the established player.',
      points: [
        { feature: 'Price (Pro)', a: '$9/mo', b: '$19.99/mo' },
        { feature: 'Free tier', a: 'Yes (1K ops)', b: 'Yes (100 tasks)' },
        { feature: 'Visual workflow', a: 'Yes', b: 'Basic' },
        { feature: 'Apps supported', a: '1,000+', b: '6,000+' },
        { feature: 'Learning curve', a: 'Moderate', b: 'Easy' },
        { feature: 'Error handling', a: 'Advanced', b: 'Basic' },
      ],
      verdict: 'Make.com is cheaper, more powerful, but steeper learning curve. Zapier is easier but costs 2x.' },
    { slug: 'surfer-vs-ahrefs', a: 'Surfer SEO', b: 'Ahrefs', winner: 'Surfer',
      intro: 'Both excellent SEO tools. Different strengths.',
      points: [
        { feature: 'AI content optimization', a: 'Best in class', b: 'Newer feature' },
        { feature: 'Backlink analysis', a: 'Basic', b: 'Best in class' },
        { feature: 'Keyword research', a: 'Yes', b: 'Yes' },
        { feature: 'Price', a: '$89/mo', b: '$99/mo' },
        { feature: 'SERP analysis', a: 'Real-time', b: 'Daily' },
        { feature: 'Content editor', a: 'Yes', b: 'Yes' },
      ],
      verdict: 'Surfer is built for AI content. Ahrefs is built for backlinks. Pick the one that matches your strategy.' },
    { slug: 'claude-pro-vs-chatgpt-plus', a: 'Claude Pro', b: 'ChatGPT Plus', winner: 'Claude Pro',
      intro: 'Both are excellent. We pay for both, but Claude gets used 3x more.',
      points: [
        { feature: 'Price', a: '$20/mo', b: '$20/mo' },
        { feature: 'Context window', a: '200K tokens', b: '128K tokens' },
        { feature: 'Coding', a: 'Best in class', b: 'Good' },
        { feature: 'Image generation', a: 'No', b: 'Yes (DALL-E)' },
        { feature: 'Voice', a: 'No', b: 'Yes' },
        { feature: 'Web search', a: 'No', b: 'Yes' },
        { feature: 'Honest about limits', a: 'Yes', b: 'Less so' },
      ],
      verdict: 'Claude wins for writing, coding, analysis. ChatGPT wins for image gen and voice. We use Claude 3x more.' },
  ];
  return comparisons.map(c => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
---

<BaseLayout title={c.title} description={c.intro}>
  <article class="container-x py-10">
    <nav class="text-2xs uppercase tracking-wider text-ink-400">
      <a href="/compare" class="hover:text-white">Comparisons</a>
      <span class="mx-2">/</span>
      <span>{c.a} vs {c.b}</span>
    </nav>

    <header class="mt-3">
      <div class="flex items-center gap-4">
        <BrandLogo brand={c.a} size="lg" />
        <span class="text-2xl text-ink-500">vs</span>
        <BrandLogo brand={c.b} size="lg" />
      </div>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">{c.title}</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-300">{c.intro}</p>
    </header>

    <!-- Comparison table -->
    <section class="mt-10 card overflow-hidden p-0">
      <table class="w-full text-sm">
        <thead class="bg-ink-800 text-2xs uppercase tracking-wider text-ink-400">
          <tr>
            <th class="p-3 text-left">Feature</th>
            <th class="p-3 text-left">{c.a}</th>
            <th class="p-3 text-left">{c.b}</th>
          </tr>
        </thead>
        <tbody>
          {c.points.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-ink-900/50' : ''}>
              <td class="p-3 font-medium text-white">{p.feature}</td>
              <td class="p-3 text-ink-200">{p.a}</td>
              <td class="p-3 text-ink-200">{p.b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Verdict -->
    <section class="mt-8 rounded-2xl border-2 border-accent/40 bg-gradient-to-br from-accent/10 to-accent/5 p-8 text-center">
      <p class="text-2xs uppercase tracking-wider text-accent">Our verdict</p>
      <p class="mx-auto mt-2 max-w-2xl text-xl font-bold text-white">{c.verdict}</p>
      <p class="mt-3 text-sm text-accent">Winner: {c.winner}</p>
    </section>

    <!-- CTAs -->
    <section class="mt-8 grid gap-4 sm:grid-cols-2">
      <a href={`https://${c.a.toLowerCase().replace(/[^a-z0-9]/g, '')}.com/?via=uzinetwork`} target="_blank" rel="sponsored noopener noreferrer" class="card flex items-center justify-between p-5 hover:border-accent/40">
        <div>
          <BrandLogo brand={c.a} size="sm" />
          <p class="mt-2 text-sm text-ink-300">Try {c.a} →</p>
        </div>
        <span class="text-2xl text-ink-500">→</span>
      </a>
      <a href={`https://${c.b.toLowerCase().replace(/[^a-z0-9]/g, '')}.com/?via=uzinetwork`} target="_blank" rel="sponsored noopener noreferrer" class="card flex items-center justify-between p-5 hover:border-accent/40">
        <div>
          <BrandLogo brand={c.b} size="sm" />
          <p class="mt-2 text-sm text-ink-300">Try {c.b} →</p>
        </div>
        <span class="text-2xl text-ink-500">→</span>
      </a>
    </section>
  </article>
</BaseLayout>
